# Web server settings for the Hostinger hosting (Apache/LiteSpeed). Copied to the site root on
# every build. HTTPS itself (certificate and HTTP → HTTPS redirect) is managed in hPanel.

# The site's own "page not found" page, and no folder listings.
ErrorDocument 404 /404.html
Options -Indexes

# One address: www.eternoscarrental.com → eternoscarrental.com.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  # Browsers only ever use HTTPS for the site (one year).
  Header always set Strict-Transport-Security "max-age=31536000"
  # No guessing file types, no framing by other sites, no full URLs leaked to other sites.
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  # Everything the pages load comes from the site itself. Inline scripts and styles are allowed
  # because the pages use small inline ones (intro, structured data, Astro's inlined styles).
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"

  # Scripts, styles, fonts and images can be reused from the browser cache for a week. (Pages
  # themselves are always checked, so new content shows up right away.)
  <FilesMatch "\.(js|css|woff2|webp|avif|jpe?g|png|svg)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
